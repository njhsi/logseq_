+(defn array-buffer->base64 [buffer]
+  (let [bytes (js/Uint8Array. buffer)
+        binary-str (js/String.fromCharCode.apply nil bytes)]
+    (js/btoa binary-str)))
+
+(defn <export-private-key->pem  [private-key]
+  (assert (instance? js/CryptoKey private-key))
+  (p/let [exported (.exportKey subtle "pkcs8" private-key)
+          b64 (array-buffer->base64 exported)
+	  chunks (->> b64
+                    (partition-all 64)
+                    (map #(apply str %)))
+          body (string/join "\n" chunks)]
+	(str "-----BEGIN PRIVATE KEY-----\n"
+         body
+         "\n-----END PRIVATE KEY-----")))
+
+(defn <export-public-key->pem  [public-key]
+  (assert (instance? js/CryptoKey public-key))
+  (p/let [exported (.exportKey subtle "spki" public-key)
+          b64 (array-buffer->base64 exported)
+	  chunks (->> b64
+                    (partition-all 64)
+                    (map #(apply str %)))
+          body (string/join "\n" chunks)]
+	(str "-----BEGIN PUBLIC KEY-----\n"
+         body
+         "\n-----END PUBLIC KEY-----")))
+
+
+;; 1. Convert PEM string to a raw byte ArrayBuffer
+(defn pem->array-buffer [pem-str]
+  (let [;; Strip out Begin/End headers and any whitespace
+        binary-str (-> pem-str
+                       (string/replace #"-{5}BEGIN[A-Z0-9 ]+-{5}" "")
+                       (string/replace #"-{5}END[A-Z0-9 ]+-{5}" "")
+                       (string/replace #"\s" ""))
+        ;; Base64 decode the string into binary
+        byte-characters (.atob js/window binary-str)
+        byte-len        (.-length byte-characters)
+        array-buffer    (js/ArrayBuffer. byte-len)
+        ui-array        (js/Uint8Array. array-buffer)]
+    (loop [i 0]
+      (when (< i byte-len)
+        (aset ui-array i (.charCodeAt byte-characters i))
+        (recur (inc i))))
+    array-buffer))
+
+;; 2. Import the ArrayBuffer using Web Crypto API
+(defn import-rsa-key [pem-text key-type]
+  (let [is-private? (= key-type :private)
+        format        (if is-private? "pkcs8" "spki")
+        usages        (if is-private? #{"decrypt"} #{"encrypt"})
+        ab-data       (pem->array-buffer pem-text)]
+    (-> (js/window.crypto.subtle.importKey
+         format
+         ab-data
+         #js {:name "RSA-OAEP" :hash "SHA-256"}
+         true
+         (to-array usages))
+        (.then (fn [crypto-key]
+                 crypto-key))
+        (.catch (fn [err]
+                  (js/console.error "Error importing key:" err))))))
+
+(defn <encrypt-bassword-by-key
+  [pubkey bassword]
+  (assert (and (instance? js/CryptoKey pubkey)
+               (string? bassword)))
+  (p/let [encoded (.encode (js/TextEncoder.) bassword)
+          encrypted (.encrypt subtle
+                                      #js {:name "RSA-OAEP" :hash "SHA-256"}
+                                      pubkey
+                                      encoded)]
+            (array-buffer->base64 encrypted)				     
+;;	  b64 (array-buffer->base64 encrypted)
+;;	  chunks (->> b64
+;;                    (partition-all 64)
+;;                    (map #(apply str %)))
+;;          body (string/join "\n" chunks)]
+;;        (str body)
+))
